# ════════════════════════════════════════════════════════════
# AGENTE MARQUILLAS S.A.S — Plantilla de variables de entorno
# ════════════════════════════════════════════════════════════
# INSTRUCCIONES:
#   1. Copia este archivo y renómbralo a ".env" (sin la extensión .example)
#   2. Reemplaza CADA valor de ejemplo con tu valor real
#   3. NUNCA subas el archivo .env a Git (ya está en .gitignore)
# ════════════════════════════════════════════════════════════

# ── OPENAI ─────────────────────────────────────────────────
# Clave de la API de OpenAI para acceder a GPT-4o.
# Cómo obtenerla: https://platform.openai.com → API Keys → Create new secret key
OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── MICROSOFT AZURE ────────────────────────────────────────
# Credenciales de la aplicación registrada en Azure Active Directory.
# El área de IT las genera en: https://portal.azure.com
# Ver sección "Cómo configurar Azure" en el README.md para instrucciones detalladas.

# Identificador único de la aplicación registrada en Azure
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Secreto de cliente generado en Azure (tratar como contraseña)
AZURE_CLIENT_SECRET=tu_secreto_de_azure_aqui_generado_en_portal

# Identificador del directorio (tenant) de la organización en Azure
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── CORREOS ────────────────────────────────────────────────
# Correo que monitorea el agente (remitente de todos los correos automáticos)
EMAIL_MONITOREAR=correo.agente@tuempresa.com.co

# ── CARPETAS OUTLOOK (FASE 5) ──────────────────────────────
# Nombre exacto de las carpetas que deben existir en Outlook
CARPETA_APROBADAS=APROBADAS
CARPETA_RECHAZADAS=RECHAZADAS

# Carpeta del mes donde se archivan las facturas procesadas.
# Si se deja vacío, el sistema detecta el mes actual automáticamente y crea
# la carpeta en la raíz del buzón si no existe (ej: JULIO, AGOSTO...).
# Si se pone un valor, fuerza ese nombre de carpeta sin importar el mes.
CARPETA_MES=

# ── CORREOS DE ALMACENES ───────────────────────────────────
# Almacén Sabaneta — destinatario principal
EMAIL_SABANETA_PRINCIPAL=responsable.sabaneta@tuempresa.com.co
# Almacén Sabaneta — copia
EMAIL_SABANETA_COPIA=copia.sabaneta@tuempresa.com.co

# Almacén Rionegro — destinatario principal
EMAIL_RIONEGRO_PRINCIPAL=responsable.rionegro@tuempresa.com.co
# Almacén Rionegro — copia
EMAIL_RIONEGRO_COPIA=copia.rionegro@tuempresa.com.co

# Correos que siempre van en copia en todos los envíos sin importar el almacén
# Separados por coma sin espacios (puede ser uno o varios)
EMAIL_COPIA_SIEMPRE=administracion@tuempresa.com.co,otro@tuempresa.com.co

# ── CONFIGURACIÓN DEL AGENTE ───────────────────────────────
# Cada cuántos minutos el agente revisa si hay correos nuevos.
# Recomendado: 5 (no usar menos de 2 para no sobrecargar la API)
INTERVALO_MINUTOS=5

# URL del endpoint de la API REST que recibe los datos de las facturas aprobadas
# Si está vacía no se envía nada
API_FACTURAS_URL=

# URL del endpoint para actualizar el estado de aprobación de una factura
# Si está vacía no se envía nada
API_FACTURAS_URL_ESTADO=http://marquillas-store.test/ws/actualizar-estado-factura

# URL para verificar si una factura ya existe en la base de datos
API_VERIFICAR_FACTURA_URL=https://marquillas.store/ws/verificar-factura

# ── SHAREPOINT — FACTURACIÓN ELECTRÓNICA ───────────────────
# URL del sitio de SharePoint donde se suben y mueven los PDFs de facturas
SHAREPOINT_SITE_URL=https://tuempresa.sharepoint.com/sites/TuSitio
# Nombres exactos de las carpetas que deben existir en la biblioteca "Documentos" del sitio
SHAREPOINT_CARPETA_SIN_APROBAR=SIN APROBAR
SHAREPOINT_CARPETA_APROBADAS=APROBADAS
SHAREPOINT_CARPETA_RECHAZADAS=RECHAZADAS
SHAREPOINT_CARPETA_NOTAS_CREDITO=NOTAS CREDITO

API_FACTURAS_URL=